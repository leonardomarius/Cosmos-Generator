# Copie ce fichier en ".env.local" puis remplis les valeurs.
# Ne partage JAMAIS le fichier .env.local (il est ignoré par git).

# Supabase (Project Settings > API). La clé service_role sert au serveur à
# écrire les abonnements et les tokens : ne jamais l'exposer au navigateur.
# Tables : coller supabase/migrations/*.sql dans le SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mollie (Développeurs > Clés API) : "test_…" pour essayer, "live_…" en
# production. Rien d'autre à configurer chez Mollie : l'URL du webhook
# (<PUBLIC_BASE_URL>/api/webhooks/mollie) est envoyée avec chaque paiement,
# et les prix viennent de PLANS dans src/config/product.ts.
MOLLIE_API_KEY=

# fal.ai
FAL_KEY=
# Optionnel : la vidéo de référence (public/exemple.mp4) est convertie en 16 fps
# et envoyée à fal.ai automatiquement. Ne remplir que pour forcer une autre URL.
REFERENCE_VIDEO_URL=

# Admin : emails autorisés, séparés par des virgules (jamais affichés sur le site)
ADMIN_EMAILS=

# Email de contact affiché dans les mentions légales et la confidentialité.
# Une adresse dédiée (ex. support@cosmosgenerator.com), pas une adresse perso.
SUPPORT_EMAIL=

# URL publique du site, en https, sans "/" final (ex. https://www.cosmosgenerator.com).
# Sert à construire l'URL du webhook fal.ai : en local, mettre l'URL du tunnel
# (cloudflared, ngrok), car fal ne peut pas joindre localhost.
PUBLIC_BASE_URL=
# Secret qui chiffre l'email du client dans l'URL du webhook (32 caractères minimum).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_TOKEN_SECRET=

# Resend : envoi de la vidéo par email
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex. Cosmos Generator <video@cosmosgenerator.com>
EMAIL_FROM=
